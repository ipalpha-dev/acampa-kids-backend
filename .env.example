# ── Server ────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────
MONGODB_URI=mongodb://camping:camping-local-only@localhost:27019/camping?authSource=admin
MONGODB_DB=camping

# ── Uploaded images (editor + photo album) ───────────────
# Folder where the image BYTES live (Mongo keeps only the metadata).
# Point it at a mounted volume in production.
FILES_DIR=data/files

# ── IPAlpha core (identity, people, roles, messages) — CONTRACTS_ACAMPA §10–§15 ──
# Every variable below is required: without them nobody can sign in (the API
# still boots and answers IPALPHA_UNAVAILABLE on the login routes).
IPALPHA_AUTH_API_URL=
IPALPHA_AUTH_ORIGIN=
IPALPHA_PERSONS_API_URL=
IPALPHA_PROJECTS_API_URL=
IPALPHA_NOTIFICATIONS_API_URL=
IPALPHA_TOKEN_ISSUER=
IPALPHA_CLIENT_ID=
IPALPHA_ENTRY_POINT=
IPALPHA_CLIENT_SECRET=
IPALPHA_REDIRECT_URI=
# the app-bound system client: login:relay, projects:editions, projects:app-members,
# projects:templates, persons:app-names, notifications:send-template
IPALPHA_SYSTEM_CLIENT_ID=
IPALPHA_SYSTEM_CLIENT_SECRET=
# the one yearly Acampa project (camps are its editions)
IPALPHA_PROJECT_ID=
# 32 bytes (64 hex chars or base64) — seals the per-role IPAlpha tokens kept in the
# Acampa session (AES-256-GCM). Generate: openssl rand -hex 32
SESSION_TOKEN_KEY=
# fallback session length when auth-api answers no sessionIdleHours
SESSION_HOURS=96
# deployment owners (comma list of IPAlpha person ids): seeds, import caches, archived writes
SUPER_ADMIN_PERSON_IDS=

# ── Messages (sent by notifications-api with the project's templates) ──
# Public URL of the app — the {link} of the message templates.
APP_URL=
# Messages to the same person with the same template inside this window collapse into one (default 20s).
NOTIFY_COALESCE_SECONDS=20

# ── Face search on the parents' photo tab ─────────────────
# Private InsightFace service (backend/face-service). EMPTY = feature disabled.
FACE_SERVICE_URL=
# Cosine similarity a gallery face must reach to be a match. Low on purpose: find the kid, extras are ok.
FACE_MATCH_THRESHOLD=0.22
# Detections weaker than this are ignored (blurry / tiny faces in group shots).
FACE_MIN_DETECTION_SCORE=0.4

# ── Background import worker → API callback ──
# Shared secret for POST /api/worker/reviewed (worker tells the API a review
# finished so it can push the websocket event). Same value in both processes.
# EMPTY = the endpoint refuses everything and the worker skips the callback.
WORKER_SECRET=
# Where the worker reaches the API (only needed when it is not localhost:PORT).
# BACKEND_URL=http://localhost:3000

# ── AI helper in the WYSIWYG editor (OpenAI-compatible gateway) ──
# Leave EMPTY to hide the feature.
AI_BASE_URL=https://ai-models.kevyn.com.br/v1
AI_API_KEY=

# ── TypeSafe Jev through OpenRouter ──
# Server-side only. Used for form-icon suggestions and first-pass spreadsheet column mapping.
OPENROUTER_API_KEY=
# ── Two-way voice conversation with the assistant (GPT-Live) ──
# Needs OpenAI directly (POST /v1/live/sessions) — an OpenAI-compatible gateway is not enough.
# Leave the key EMPTY to disable the assistant drawer.
AI_LIVE_BASE_URL=https://api.openai.com/v1
AI_LIVE_API_KEY=
AI_LIVE_MODEL=gpt-live-1
# Brazilian Portuguese: bossa (feminine) or tempo (masculine). Default: marin.
AI_LIVE_VOICE=marin
# Reasoning model GPT-Live delegates to; it is the one that reads MongoDB.
AI_LIVE_BACKEND_MODEL=gpt-5.6-terra

# Speech-to-text for voice messages in the assistant chat (OpenAI-compatible /audio/transcriptions).
# Defaults to the home whisper server; set AI_TRANSCRIBE_URL empty to hide the mic.
# AI_TRANSCRIBE_URL=https://whisper.kevyn.com.br/v1
# AI_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# AI_TRANSCRIBE_KEY=
